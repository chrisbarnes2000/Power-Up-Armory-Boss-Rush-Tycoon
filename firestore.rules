rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny all access
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.isAdmin == true ||
        request.auth.uid == 'WlMw7jRoVgSl2kyjH6B47DLayU72' ||
        (request.auth.token.email != null && request.auth.token.email == 'Chris.Barnes.2000@me.com') ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true)
      );
    }

    function incoming() {
      return request.resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidUser(data, userId) {
      return data.userId == userId &&
        data.displayName is string &&
        data.displayName.size() > 0 &&
        data.displayName.size() <= 64 &&
        (!('email' in data) || (data.email is string && data.email.size() <= 256)) &&
        (!('avatar' in data) || (data.avatar is string && data.avatar.size() <= 16)) &&
        (!('title' in data) || (data.title is string && data.title.size() <= 64)) &&
        (!('powerScore' in data) || (data.powerScore is number)) &&
        (!('totalBossesDefeated' in data) || (data.totalBossesDefeated is number)) &&
        (!('coins' in data) || (data.coins is number)) &&
        (!('isAdmin' in data) || (data.isAdmin is bool));
    }

    function isValidLeaderboard(data, userId) {
      return data.userId == userId &&
        data.name is string &&
        data.name.size() > 0 &&
        data.name.size() <= 64 &&
        data.score is number &&
        data.score >= 0 &&
        data.bosses is number &&
        data.bosses >= 0 &&
        data.coins is number &&
        (!('avatar' in data) || (data.avatar is string && data.avatar.size() <= 16)) &&
        (!('title' in data) || (data.title is string && data.title.size() <= 64));
    }

    // User Profile Documents
    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      allow create: if (isOwner(userId) || isAdmin()) && isValidId(userId) && isValidUser(incoming(), userId);
      allow update: if (isOwner(userId) || isAdmin()) && isValidId(userId) && isValidUser(incoming(), userId);
      allow delete: if isOwner(userId) || isAdmin();
    }

    // Global Hall of Champions Leaderboard
    match /leaderboard/{userId} {
      allow read: if true;
      allow create: if (isOwner(userId) || isAdmin()) && isValidId(userId) && isValidLeaderboard(incoming(), userId);
      allow update: if (isOwner(userId) || isAdmin()) && isValidId(userId) && isValidLeaderboard(incoming(), userId);
      allow delete: if isOwner(userId) || isAdmin();
    }

    // Storefront Purchases & In-Store Receipts
    match /purchases/{codeId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if isAdmin();
    }
  }
}
